# ── Core ────────────────────────────────────────────────────────────────
# API key clients must send as X-API-Key to the backend
AGENCY_API_KEY=change-me
# sqlite for dev; postgres in docker-compose / production
DATABASE_URL=sqlite+aiosqlite:///./agency.db
# Root directory for the artifact store (per-project folders live under it)
ARTIFACT_ROOT=./artifacts
# Comma-separated CORS origins for the dashboard
CORS_ORIGINS=http://localhost:3000

# ── LLM (required) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Model routing (override per-task models; defaults in app/core/router.py)
MODEL_HEAVY=claude-opus-5
MODEL_STANDARD=claude-sonnet-5
MODEL_LIGHT=claude-haiku-4-5

# ── Image generation (at least one) ─────────────────────────────────────
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
STABILITY_API_KEY=

# ── Voice ───────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Free fallback (no key needed): edge-tts voice for Hindi
EDGE_TTS_VOICE=hi-IN-MadhurNeural

# ── Motion video (optional; Ken-Burns FFmpeg engine is the built-in fallback)
KLING_API_KEY=
RUNWAY_API_KEY=

# ── Search fallback (Anthropic server-side web search is primary) ───────
TAVILY_API_KEY=

# ── YouTube ─────────────────────────────────────────────────────────────
# Path to the OAuth client secret downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRET_FILE=./secrets/client_secret.json
# Where the refresh token is stored after /api/youtube/connect
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json
YOUTUBE_DEFAULT_PRIVACY=private

# ── Notifications (optional) ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
NOTIFY_WEBHOOK_URL=

# ── Music (copyright-safe local library; see docs) ──────────────────────
MUSIC_LIBRARY_DIR=./assets/music

# ── Quality gates (0-100) ───────────────────────────────────────────────
GATE_RESEARCH=90
GATE_FACT_CHECK=95
GATE_SCRIPT=90
GATE_VISUAL=88
GATE_VOICE=90
GATE_EDIT=90
GATE_THUMBNAIL=88
GATE_SEO=85
GATE_FINAL=92
MAX_REVISION_LOOPS=3
